{
  "name": "securebrowser",
  "version": "0.2.0",
  "description": "Kişisel Güvenli Browser - Faz 2: WireGuard VPN",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "node-fetch": "^3.3.2"
  },
  "build": {
    "appId": "com.personal.securebrowser",
    "productName": "SecureBrowser",
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
