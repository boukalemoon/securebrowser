{
  "name": "ilgezdi",
  "version": "0.8.3",
  "description": "İlgezdi — Güvenli, gizlilik odaklı web tarayıcısı (Göktürk temalı)",
  "author": "İlgezdi",
  "license": "MIT",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node test/run.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "firebase-admin": "^12.7.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "sql.js": "^1.12.0"
  },
  "build": {
    "appId": "com.ilgezdi.browser",
    "productName": "İlgezdi",
    "copyright": "Copyright © 2026 İlgezdi",
    "publish": [
      {
        "provider": "github",
        "owner": "boukalemoon",
        "repo": "securebrowser"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "Ilgezdi-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/{.DS_Store,.git,.github,docs,site,tasarım backup}"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Ilgezdi-Kurulum-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "İlgezdi",
      "uninstallDisplayName": "İlgezdi ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1055",
      "include": "build/installer.nsh",
      "displayLanguageSelector": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "İlgezdi ${version}",
      "artifactName": "Ilgezdi-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Ilgezdi-linux-${arch}.${ext}",
      "category": "Network;WebBrowser",
      "maintainer": "İlgezdi <destek@ilgezdi.com>",
      "synopsis": "Güvenli, gizlilik odaklı web tarayıcısı",
      "description": "İlgezdi — Göktürk temalı, reklam/izleyici engelleyici ve VPN destekli güvenli web tarayıcısı."
    }
  }
}
